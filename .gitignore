# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# 虛擬環境
venv/
.venv/
env/

# 測試 / 快取
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# 打包輸出
build/
dist/

# 作業系統 / 編輯器
.DS_Store
*.log

# 讓 .vscode 設定檔可被追蹤，但忽略個人化的工作區檔案
.vscode/*.code-workspace

# 執行期產生的個人化設定（音量等）
settings.json

# 西洋棋引擎（Stockfish 執行檔，體積過大不納入版本控制，需另外安裝）
# 保留 engines/README.md 讓安裝說明可以進版本控制。
engines/*
!engines/README.md
